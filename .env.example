# Frontend
VITE_LIVEKIT_URL=wss://your-livekit-server
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:8787/api/livekit/token
# Set to true to call Cloud Functions on the local emulator (firebase emulators:start)
VITE_USE_FUNCTIONS_EMULATOR=false
# TURN relay for 1-to-1 calls between networks that cannot connect directly (optional).
# Comma-separated URLs from your TURN provider, plus its username and credential.
VITE_TURN_URLS=turn:your-turn-server:80,turn:your-turn-server:443?transport=tcp,turns:your-turn-server:443?transport=tcp
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-credential

# Token server
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_PORT=8787
APP_ORIGIN=http://localhost:5173
# Firebase Admin uses GOOGLE_APPLICATION_CREDENTIALS or the hosting provider's service account.
# Never commit the service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
