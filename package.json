{
  "name": "eduswap-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-eduswap \"vitest run -c vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-eduswap \"playwright test\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "seed": "npx tsx src/scripts/seedFirestore.ts",
    "seed:remaining": "npx tsx src/scripts/seedRemaining.ts",
    "migrate:users": "npx tsx src/scripts/migrateUserDefaults.ts",
    "migrate:public-profiles": "npx tsx src/scripts/migratePublicProfiles.ts",
    "migrate:registration-documents": "npx tsx src/scripts/migrateRegistrationDocuments.ts",
    "promote:owner": "npx tsx src/scripts/promoteOwner.ts",
    "preview": "vite preview",
    "livekit:server": "tsx --env-file=.env.local server/livekitTokenServer.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.3.0",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^1.7.0",
    "nodemailer": "^10.0.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^1.0.0"
  }
}
